#!/bin/bash

#SBATCH --job-name=meegflow
#SBATCH --ntasks-per-node=10
#SBATCH --mem=10G
#SBATCH --time=00:15:00

# Copyright (c) 2026 brainlife.io
#
# This is the main file run by the brainlife.io orchestration system
#
# Author: Maximilien Chaumon

set -e
set -x

# Run the actual python code.
#
# -u: unbuffered stdout, so print() output lands in the slurm log immediately
# instead of sitting in a block-buffered pipe. The web UI shows the last line
# this job wrote to stdout as its live status, so main.py prints a short
# message right before each step that's slow enough to otherwise leave a
# stale status behind (and pins MNE's log level so meegflow's own per-step
# logging keeps reaching stdout too).
#
# meegflow's own code always comes from the vendored git submodule
# (meegflow/), never from a Docker image -- main.py puts it first on
# sys.path regardless of what the container has installed. So this only
# needs a plain MNE runtime, not a dedicated meegflow image: use the same
# brainlifemeeg/mne image every other app here uses, topped up with the two
# small pure-Python packages meegflow needs that it doesn't already have
# (rich, PyYAML -- mne/scipy/numpy/pandas are already baked in, so this is
# fast). --user avoids needing write access to the image's own site-packages.
singularity exec docker://brainlifemeeg/mne:1.12.1 bash -c "pip install --user --no-cache-dir --quiet rich pyyaml && python3 -u main.py"
