#!/bin/bash

#SBATCH --job-name=meegflow
#SBATCH --ntasks-per-node=10
#SBATCH --mem=10G
#SBATCH --time=00:15:00

# Copyright (c) 2026 brainlife.io
#
# This is the main file run by the brainlife.io orchestration system
#
# Author: Maximilien Chaumon

set -e
set -x

# Run the actual python code.
#
# -u: unbuffered stdout, so print() output lands in the slurm log immediately
# instead of sitting in a block-buffered pipe. The web UI shows the last line
# this job wrote to stdout as its live status, so main.py prints a short
# message right before each step that's slow enough to otherwise leave a
# stale status behind (and pins MNE's log level so meegflow's own per-step
# logging keeps reaching stdout too).
singularity exec docker://ghcr.io/brainlifemeeg/meegflow:latest python3 -u main.py
