#!/bin/bash

#SBATCH --job-name=meegflow
#SBATCH --ntasks-per-node=10
#SBATCH --mem=10G
#SBATCH --time=00:15:00

# Copyright (c) 2026 brainlife.io 
# 
# This is the main file run by the brainlife.io orchestration system
#
# Author: Maximilien Chaumon

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Read config.json
RAW_PATH=$(jq -r '.raw' "$SCRIPT_DIR/config.json")
YAML_CONTENT=$(jq -r '.yaml' "$SCRIPT_DIR/config.json")

# Get absolute path and directory of raw data file
RAW_ABS_PATH=$(cd "$(dirname "$RAW_PATH")" && pwd)/$(basename "$RAW_PATH")
RAW_DIR=$(dirname "$RAW_ABS_PATH")

# Write YAML content to temporary config file
CONFIG_YAML="$SCRIPT_DIR/config.yaml"
echo "$YAML_CONTENT" > "$CONFIG_YAML"

echo "Raw data path: $RAW_ABS_PATH"
echo "Raw data directory: $RAW_DIR"
echo "Config YAML path: $CONFIG_YAML"

# Run singularity with dynamic bindings
singularity exec \
    -B "$RAW_DIR":/data \
    -B "$CONFIG_YAML":/config.yaml \
    docker://ghcr.io/brainlifemeeg/meegflow:latest \
    ls -l /data && \
    ls -l /config.yaml
    # meegflow \
    # --reader "glob" \
    # --glob "/*.fif" \
    # --data-root /data \
    # --config /config.yaml
 